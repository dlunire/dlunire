{
    "name": "dlunire/dlunire",
    "description": "DLUnire — framework PHP orientado a API. Skeleton, controladores, rutas JSON, ORM, .env.type tipado. Kernel DLCore, HTTP DLRoute y almacenamiento DLStorage.",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "homepage": "https://dlunire.dev/",
    "support": {
        "issues": "https://github.com/dlunire/dlunire/issues",
        "source": "https://github.com/dlunire/dlunire"
    },
    "autoload": {
        "psr-4": {
            "DLUnire\\": "app/",
            "Framework\\": "dlunire/",
            "Boot\\": "boot/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "David E Luna M (Códigos del Futuro (@cdelfuturo en X), DLUnire Framework)",
            "email": "dlunireframework@gmail.com",
            "homepage": "https://dlunire.dev",
            "role": "Founder & Software Developer"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require": {
        "php": ">=8.2",
        "dompdf/dompdf": "^3.1",
        "dlunire/dlcore": "^2.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "scripts": {
        "dev": "php -S localhost:3000 -t public/",
        "test": "phpunit --colors=always",
        "setup-env": "@php bin/setup-env.php",
        "post-create-project-cmd": [
            "@php bin/setup-env.php"
        ]
    }
}
